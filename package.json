{
  "name": "dsh-feishu-integration",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "飞书与 DeepSeek Harness 双向集成：总结推送、回复路由、绑定 UI 与二维码 provisioning。 / Bidirectional Feishu integration for DeepSeek Harness: summary delivery, reply routing, binding UI, and QR provisioning.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangwuan55/dsh-feishu-integration.git"
  },
  "homepage": "https://github.com/yangwuan55/dsh-feishu-integration",
  "bugs": {
    "url": "https://github.com/yangwuan55/dsh-feishu-integration/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "lark",
    "integration",
    "reply-routing"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "bin": {
    "fsum-admin": "./bin/fsum-admin.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
